.katex .mtable .col-align-l > .vlist-t { text-align: left; }

.katex .mtable .col-align-r > .vlist-t { text-align: right; }

.katex .svg-align { text-align: left; }

.katex svg { fill: currentcolor; stroke: currentcolor; display: block; heig=
ht: inherit; position: absolute; width: 100%; }

.katex svg path { stroke: none; }

.katex svg { fill-rule: nonzero; fill-opacity: 1; stroke-width: 1; stroke-l=
inecap: butt; stroke-linejoin: miter; stroke-miterlimit: 4; stroke-dasharra=
y: none; stroke-dashoffset: 0; stroke-opacity: 1; }

.katex img { border-style: none; max-height: none; max-width: none; min-hei=
ght: 0px; min-width: 0px; }

