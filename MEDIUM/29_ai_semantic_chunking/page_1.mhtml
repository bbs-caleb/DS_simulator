        """</span>
        <span class=3D"hljs-keyword">return</span> [
            <span class=3D"hljs-built_in">float</span>(cosine(embeddings[i]=
, embeddings[i + <span class=3D"hljs-number">1</span>]))
            <span class=3D"hljs-keyword">for</span> i <span class=3D"hljs-k=
eyword">in</span> <span class=3D"hljs-built_in">range</span>(<span class=3D=
"hljs-built_in">len</span>(embeddings) - <span class=3D"hljs-number">1</spa=
n>)
        ]

    <span class=3D"hljs-keyword">def</span> <span class=3D"hljs-title funct=
ion_">_find_breakpoints</span>(<span class=3D"hljs-params">self, distances:=
 <span class=3D"hljs-type">List</span>[<span class=3D"hljs-built_in">float<=
/span>]</span>) -&gt; <span class=3D"hljs-type">List</span>[<span class=3D"=
hljs-built_in">int</span>]:
