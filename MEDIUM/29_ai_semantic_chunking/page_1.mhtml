    <span class=3D"hljs-keyword">def</span> <span class=3D"hljs-title funct=
ion_">_calculate_distances</span>(<span class=3D"hljs-params">self, embeddi=
ngs: np.ndarray</span>) -&gt; <span class=3D"hljs-type">List</span>[<span c=
lass=3D"hljs-built_in">float</span>]:
