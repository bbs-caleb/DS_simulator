rd">in</span> <span class=3D"hljs-built_in">range</span>(<span class=3D"hlj=
s-built_in">len</span>(sentences)):
            combined =3D <span class=3D"hljs-string">" "</span>.join(
                sentences[<span class=3D"hljs-built_in">max</span>(i - self=
.buffer_back, <span class=3D"hljs-number">0</span>) : i + <span class=3D"hl=
js-number">1</span> + self.buffer_forward]
