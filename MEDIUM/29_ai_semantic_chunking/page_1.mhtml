            The text to be split.

        Returns
        -------
        List[str]
            A list of semantically coherent text chunks.
        """</span>
        sentences =3D self._split_text(text)
        combined_sentences =3D self._combine_sentences(sentences)
        embeddings =3D np.array(self.model.encode(combined_sentences))
        distances =3D self._calculate_distances(embeddings)
        indices =3D self._find_breakpoints(distances)
        chunks =3D self._group_sentences(sentences, indices)
        <span class=3D"hljs-keyword">return</span> chunks

    <span class=3D"hljs-keyword">def</span> <span class=3D"hljs-title funct=
ion_">_split_text</span>(<span class=3D"hljs-params">self, text: <span clas=
s=3D"hljs-built_in">str</span></span>) -&gt; <span class=3D"hljs-type">List=
</span>[<span class=3D"hljs-built_in">str</span>]:
