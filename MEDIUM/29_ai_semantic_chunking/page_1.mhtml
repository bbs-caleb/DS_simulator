            A list of sentences extracted from the input text.
        """</span>
        pattern =3D <span class=3D"hljs-string">r"(?&lt;=3D[.!?])\s+|(?&lt;=
=3D\n\n)"</span>
        segments =3D [segment <span class=3D"hljs-keyword">for</span> segme=
nt <span class=3D"hljs-keyword">in</span> re.split(pattern, text) <span cla=
ss=3D"hljs-keyword">if</span> segment]
