<span class=3D"hljs-keyword">class</span> <span class=3D"hljs-title class_"=
>ImagePCA</span>:
    <span class=3D"hljs-string">"""
    This class compresses an image using PCA and reconstructs it upon calli=
ng.

    Attributes
    ----------
    img_path_ : str
        Stores the path of the image file.
        Load the jpg image of shape (H, W, 3)
    n_components_ : int
        Stores the number of principal components used for compression.
    mean_ : ndarray of the shape (W, 3)
        The mean value of the original image used for centering.
    Y_ : ndarray of the shape (3, H, n_components_)
        The compressed image data after applying PCA.
    Vt_ : ndarray of the shape (3, n_components_, W)
        The top n principal components from the SVD.
    """</span>

    <span class=3D"hljs-keyword">def</span> <span class=3D"hljs-title funct=
ion_">__init__</span>(<span class=3D"hljs-params">self, img_path: <span cla=
ss=3D"hljs-built_in">str</span>, n_components: <span class=3D"hljs-built_in=
">int</span></span>) -&gt; <span class=3D"hljs-literal">None</span>:
        self.img_path_ =3D img_path
        self.n_components_ =3D n_components

        self._compress()

    <span class=3D"hljs-keyword">def</span> <span class=3D"hljs-title funct=
ion_">_compress</span>(<span class=3D"hljs-params">self</span>) -&gt; <span=
 class=3D"hljs-literal">None</span>:
        <span class=3D"hljs-string">"""
        Compress the image using Singular Value Decomposition (SVD).

        The image is first converted to an array and centered. Then SVD is =
applied
        to compress the image data. This method sets the Y_ and Vt_ attribu=
tes.
        """</span>
        <span class=3D"hljs-keyword">with</span> Image.<span class=3D"hljs-=
built_in">open</span>(self.img_path_) <span class=3D"hljs-keyword">as</span=
> img:
            img =3D np.array(img)

        self.mean_ =3D img.mean(axis=3D<span class=3D"hljs-number">0</span>=
)
        img =3D img - self.mean_
        img =3D np.moveaxis(img, <span class=3D"hljs-number">2</span>, <spa=
n class=3D"hljs-number">0</span>)

        _, _, Vt =3D np.linalg.svd(img)

        Vt_ =3D Vt[:, : self.n_components_]
        Y_ =3D np.matmul(img, Vt_.transpose(<span class=3D"hljs-number">0</=
span>, <span class=3D"hljs-number">2</span>, <span class=3D"hljs-number">1<=
/span>))

        self.Y_ =3D Y_
        self.Vt_ =3D Vt_

    <span class=3D"hljs-keyword">def</span> <span class=3D"hljs-title funct=
ion_">__call__</span>(<span class=3D"hljs-params">self</span>) -&gt; PILIma=
ge:
        <span class=3D"hljs-string">"""
        Reconstruct and return the compressed image.

        When the instance is called, it reconstructs the image from the com=
pressed
        data and returns it as a PIL Image object.

        Returns
        -------
        PILImage
            The reconstructed image after PCA compression.
        """</span>
        img_ =3D np.matmul(self.Y_, self.Vt_)
        img_ =3D img_.transpose(<span class=3D"hljs-number">1</span>, <span=
 class=3D"hljs-number">2</span>, <span class=3D"hljs-number">0</span>)
        img_ +=3D self.mean_
        img_ =3D img_.clip(<span class=3D"hljs-number">0</span>, <span clas=
s=3D"hljs-number">255</span>)
        img_ =3D img_.astype(np.uint8)
        <span class=3D"hljs-keyword">return</span> Image.fromarray(img_)


<span class=3D"hljs-keyword">if</span> __name__ =3D=3D <span class=3D"hljs-=
string">"__main__"</span>:
    img_path =3D <span class=3D"hljs-string">"mug.jpg"</span>
    n_components =3D <span class=3D"hljs-number">64</span>

    img_pca =3D ImagePCA(img_path, n_components)
    img =3D img_pca()

    img.save(<span class=3D"hljs-string">"reconstructed.jpg"</span>)
