<span class=3D"hljs-keyword">def</span> <span class=3D"hljs-title function_=
">linreg_total_sales</span>(<span class=3D"hljs-params">
    sales: pd.DataFrame, ad_costs: pd.DataFrame
</span>) -&gt; <span class=3D"hljs-type">Tuple</span>[<span class=3D"hljs-b=
uilt_in">float</span>, <span class=3D"hljs-type">Dict</span>[<span class=3D=
"hljs-built_in">str</span>, <span class=3D"hljs-built_in">float</span>]]:
    <span class=3D"hljs-string">"""
    Fit linear regression model for total sales and ad costs
    Return R2 score and dict with coefficients and intercept
    Example:
    &gt;&gt;&gt; linreg_total_sales(df_sales, df_ad)
    (0.948, {
        'TV': 0.3, 'SMM': 0.6,
        'Website banners': 1.0,
        'Google Ads': 0.5,
        'intercept': 452.0
        }
    )
    """</span>
    feats =3D ad_costs.columns[<span class=3D"hljs-number">1</span>:]

    df =3D pd.merge(sales, ad_costs, on=3D<span class=3D"hljs-string">"day"=
</span>)
    y =3D df[<span class=3D"hljs-string">"sales"</span>]
    X =3D df[feats]

    model =3D LinearRegression()
    model.fit(X, y)

    r2 =3D r2_score(y, model.predict(X))
    coef =3D <span class=3D"hljs-built_in">dict</span>(<span class=3D"hljs-=
built_in">zip</span>(feats, model.coef_))

    <span class=3D"hljs-keyword">return</span> r2, coef


