            }),
        'Fashion': (0.567, {
            'TV': 0.2, 'SMM': 0.3,
            'Website banners': 7.0,
            'Google Ads': 0.1,
            'intercept': 527.0
            }),
    """</span>
    categories =3D sales[<span class=3D"hljs-string">"category"</span>].uni=
que().tolist()
    feats =3D ad_costs.columns[<span class=3D"hljs-number">1</span>:]
    result =3D {}

    <span class=3D"hljs-keyword">for</span> cat <span class=3D"hljs-keyword=
">in</span> categories:
        df =3D pd.merge(sales[sales[<span class=3D"hljs-string">"category"<=
/span>] =3D=3D cat], ad_costs, on=3D<span class=3D"hljs-string">"day"</span=
>)
        y =3D df[<span class=3D"hljs-string">"sales"</span>]
        X =3D df[feats]

        model =3D LinearRegression()
        model.fit(X, y)

        r2 =3D r2_score(y, model.predict(X))
        coef =3D <span class=3D"hljs-built_in">dict</span>(<span class=3D"h=
ljs-built_in">zip</span>(feats, model.coef_))
        result[cat] =3D (r2, coef)

    <span class=3D"hljs-keyword">return</span> result
