            <span class=3D"hljs-keyword">raise</span> TypeError(<span class=
=3D"hljs-string">f"Unrecognized init type: <span class=3D"hljs-subst">{self=
.init}</span>"</span>)

    <span class=3D"hljs-keyword">def</span> <span class=3D"hljs-title funct=
ion_">_assign_centroids</span>(<span class=3D"hljs-params">self, X: np.ndar=
ray</span>) -&gt; np.ndarray:
        <span class=3D"hljs-string">"""Assign each sample to the closest ce=
ntroid"""</span>
        y =3D np.zeros(<span class=3D"hljs-built_in">len</span>(X))

        <span class=3D"hljs-keyword">for</span> i <span class=3D"hljs-keywo=
rd">in</span> <span class=3D"hljs-built_in">range</span>(<span class=3D"hlj=
s-built_in">len</span>(X)):
            dist =3D ((X[i] - self.centroids_) ** <span class=3D"hljs-numbe=
r">2</span>).<span class=3D"hljs-built_in">sum</span>(axis=3D<span class=3D=
"hljs-number">1</span>)
            y[i] =3D np.argmin(dist)

        <span class=3D"hljs-keyword">return</span> y
