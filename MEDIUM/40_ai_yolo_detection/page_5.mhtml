js-built_in">str</span></span>) -&gt; torch.Tensor:

    <span class=3D"hljs-string">"""
    Function to get the coordinates of the bounding box of the first detect=
ed object in the image.

    Parameters:
    - img_path (str): Path to the image.

    Returns:
    - torch.Tensor: Tensor of bounding box coordinates in the format [[x1, =
y1, x2, y2]],
                    where (x1, y1) are the coordinates of the top-left corn=
er,
                    and (x2, y2) are the coordinates of the bottom-right co=
rner.
                    The tensor has a shape of (1, 4).
    """</span>

    model =3D YOLO(<span class=3D"hljs-string">"yolov8n.pt"</span>)
    results =3D model(img_path)
    coords_list =3D results[<span class=3D"hljs-number">0</span>].boxes.xyx=
y[<span class=3D"hljs-number">0</span>]
    <span class=3D"hljs-keyword">return</span> coords_list
