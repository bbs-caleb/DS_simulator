<span class=3D"hljs-keyword">class</span> <span class=3D"hljs-title class_"=
>GatedLinearUnit</span>(nn.Module):
    <span class=3D"hljs-string">"""
    Gated Linear Unit implementation.

    Args:
        input_size (int): Size of input features
        output_size (int): Size of output features

    Returns:
        torch.Tensor: Output tensor after applying GLU
    """</span>
    <span class=3D"hljs-keyword">def</span> <span class=3D"hljs-title funct=
ion_">__init__</span>(<span class=3D"hljs-params">self, input_size, output_=
size</span>):
        <span class=3D"hljs-built_in">super</span>().__init__()
        self.linear =3D nn.Linear(input_size, output_size)
        self.sigmoid =3D nn.Linear(input_size, output_size)

    <span class=3D"hljs-keyword">def</span> <span class=3D"hljs-title funct=
ion_">forward</span>(<span class=3D"hljs-params">self, x: torch.Tensor</spa=
n>) -&gt; torch.Tensor:
        <span class=3D"hljs-string">"""
        Forward pass of the GLU.

        Args:
            x (torch.Tensor): Input tensor

        Returns:
            torch.Tensor: Result of linear transformation multiplied by sig=
moid gate
        """</span>
        <span class=3D"hljs-keyword">return</span> self.linear(x) * torch.s=
igmoid(self.sigmoid(x))


<span class=3D"hljs-keyword">class</span> <span class=3D"hljs-title class_"=
>GatedResidualNetwork</span>(nn.Module):
    <span class=3D"hljs-string">"""
    Gated Residual Network implementation.

    Args:
        input_size (int): Size of input features
        hidden_size (int): Size of hidden layer
        dropout_rate (float): Dropout rate for regularization

    Returns:
        torch.Tensor: Output tensor after processing through GRN
    """</span>
    <span class=3D"hljs-keyword">def</span> <span class=3D"hljs-title funct=
ion_">__init__</span>(<span class=3D"hljs-params">self, input_size, hidden_=
size, dropout_rate</span>):
        <span class=3D"hljs-built_in">super</span>().__init__()

        self.hidden_size =3D hidden_size

        self.elu_dense =3D nn.Sequential(
            nn.Linear(input_size, hidden_size),
            nn.ELU()
        )

        self.linear_dense =3D nn.Linear(hidden_size, hidden_size)
        self.dropout =3D nn.Dropout(dropout_rate)
        self.glu =3D GatedLinearUnit(hidden_size, hidden_size)
        self.layer_norm =3D nn.LayerNorm(hidden_size)

        self.project =3D nn.Linear(input_size, hidden_size)

    <span class=3D"hljs-keyword">def</span> <span class=3D"hljs-title funct=
ion_">forward</span>(<span class=3D"hljs-params">self, x: torch.Tensor</spa=
n>) -&gt; torch.Tensor:
        <span class=3D"hljs-string">"""
        Forward pass of the GRN.

        Args:
            x (torch.Tensor): Input tensor

        Returns:
            torch.Tensor: Processed tensor
        """</span>
        <span class=3D"hljs-keyword">if</span> x.shape[-<span class=3D"hljs=
-number">1</span>] !=3D self.hidden_size:
            residual =3D self.project(x)
        <span class=3D"hljs-keyword">else</span>:
            residual =3D x

        x =3D self.elu_dense(x)
        x =3D self.linear_dense(x)
        x =3D self.dropout(x)
        x =3D self.glu(x)
        x =3D x + residual
        x =3D self.layer_norm(x)

        <span class=3D"hljs-keyword">return</span> x
