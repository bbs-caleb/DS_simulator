on: relative; transition-property: transform, visibility, opacity; white-sp=
ace: normal; }

.tippy-box[data-placement^=3D"top"] > .tippy-arrow { bottom: 0px; }

.tippy-box[data-placement^=3D"top"] > .tippy-arrow::before { border-top-col=
or: initial; border-width: 0.57rem 0.57rem 0px; bottom: -0.5rem; left: 0px;=
 transform-origin: center top; }

.tippy-box[data-placement^=3D"bottom"] > .tippy-arrow { top: 0px; }

.tippy-box[data-placement^=3D"bottom"] > .tippy-arrow::before { border-bott=
om-color: initial; border-width: 0px 0.57rem 0.57rem; left: 0px; top: -0.5r=
em; transform-origin: center bottom; }

.tippy-box[data-placement^=3D"left"] > .tippy-arrow { right: 0px; }

.tippy-box[data-placement^=3D"left"] > .tippy-arrow::before { border-left-c=
olor: initial; border-width: 0.57rem 0px 0.57rem 0.57rem; right: -0.5rem; t=
ransform-origin: left center; }

.tippy-box[data-placement^=3D"right"] > .tippy-arrow { left: 0px; }

.tippy-box[data-placement^=3D"right"] > .tippy-arrow::before { border-right=
-color: initial; border-width: 0.57rem 0.57rem 0.57rem 0px; left: -0.5rem; =
transform-origin: right center; }

.tippy-box[data-inertia][data-state=3D"visible"] { transition-timing-functi=
on: cubic-bezier(0.54, 1.5, 0.38, 1.11); }

.tippy-arrow { color: rgb(51, 51, 51); height: 1.14rem; width: 1.14rem; }

.tippy-arrow::before { border-color: transparent; border-style: solid; cont=
ent: ""; position: absolute; }

.tippy-content { padding: 0.36rem 0.64rem; position: relative; z-index: 1; =
}

