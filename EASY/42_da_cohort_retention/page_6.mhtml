df =3D pd.read_csv(<span class=3D"hljs-string">"s3_results.csv"</span>)

<span class=3D"hljs-comment"># Pivot the data to create a matrix with cohor=
t_id as rows and month_id as columns</span>
<span class=3D"hljs-comment"># The values in the pivoted table represent th=
e active_users for each cohort in a given month</span>
pivot_data =3D df.pivot(
    index=3D<span class=3D"hljs-string">"cohort_id"</span>,  <span class=3D=
"hljs-comment"># Rows of the pivot will be each cohort (cohort_id)</span>
    columns=3D<span class=3D"hljs-string">"month_id"</span>,  <span class=
=3D"hljs-comment"># Columns will represent each month (month_id)</span>
    values=3D<span class=3D"hljs-string">"active_users"</span>,  <span clas=
s=3D"hljs-comment"># Values in the table will be the active user counts</sp=
an>
).fillna(<span class=3D"hljs-number">0</span>)  <span class=3D"hljs-comment=
"># Fill missing values (if any) with 0 to avoid plotting issues</span>

<span class=3D"hljs-comment"># Calculate the sum of active users across all=
 cohorts for each month</span>
monthly_users =3D pivot_data.<span class=3D"hljs-built_in">sum</span>()

plt.figure(figsize=3D(<span class=3D"hljs-number">10</span>, <span class=3D=
"hljs-number">5</span>))

<span class=3D"hljs-comment"># Create a stacked plot where each area repres=
ents a cohort's active users across months</span>
