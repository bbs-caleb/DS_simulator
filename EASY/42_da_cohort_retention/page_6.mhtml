n class=3D"hljs-string">"upper left"</span>)
plt.grid(<span class=3D"hljs-literal">True</span>)

<span class=3D"hljs-comment"># Add text annotations to show the sum of acti=
ve users for each cohort at the top of each stack</span>
<span class=3D"hljs-keyword">for</span> i, x <span class=3D"hljs-keyword">i=
n</span> <span class=3D"hljs-built_in">enumerate</span>(pivot_data.index):
