pan>
    pivot_data,  <span class=3D"hljs-comment"># Y-axis: values of active us=
ers for each cohort and month</span>
    labels=3Dpivot_data.columns,  <span class=3D"hljs-comment"># Labels: mo=
nth IDs for the legend</span>
)


