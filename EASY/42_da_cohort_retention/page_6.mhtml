        x,
        monthly_users.iloc[i],
        <span class=3D"hljs-string">f"<span class=3D"hljs-subst">{<span cla=
ss=3D"hljs-built_in">int</span>(monthly_users.iloc[i])}</span>"</span>,
        ha=3D<span class=3D"hljs-string">"center"</span>,
        va=3D<span class=3D"hljs-string">"bottom"</span>
    )

