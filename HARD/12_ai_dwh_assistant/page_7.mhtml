        <span class=3D"hljs-string">"https://llm.api.cloud.yandex.net/found=
ationModels/v1/completion"</span>,
        headers=3Dheaders,
        data=3Djson.dumps(data),
    )

    <span class=3D"hljs-keyword">if</span> response.status_code !=3D <span =
class=3D"hljs-number">200</span>:
        <span class=3D"hljs-keyword">return</span> {
            <span class=3D"hljs-string">"status"</span>: <span class=3D"hlj=
s-string">"failure"</span>,
            <span class=3D"hljs-string">"answer"</span>: <span class=3D"hlj=
s-string">""</span>,
            <span class=3D"hljs-string">"error"</span>: <span class=3D"hljs=
-string">f"Error from YandexGPT API: <span class=3D"hljs-subst">{response.t=
ext}</span>"</span>,
        }

    response_data =3D response.json()
    result_text =3D (
        response_data.get(<span class=3D"hljs-string">"result"</span>, {})
        .get(<span class=3D"hljs-string">"alternatives"</span>, [{}])[<span=
 class=3D"hljs-number">0</span>]
        .get(<span class=3D"hljs-string">"message"</span>, {})
        .get(<span class=3D"hljs-string">"text"</span>, <span class=3D"hljs=
-string">""</span>)
    )

    <span class=3D"hljs-keyword">return</span> {
        <span class=3D"hljs-string">"status"</span>: <span class=3D"hljs-st=
ring">"success"</span>,
        <span class=3D"hljs-string">"answer"</span>: result_text,
        <span class=3D"hljs-string">"error"</span>: <span class=3D"hljs-str=
ing">""</span>,
    }

