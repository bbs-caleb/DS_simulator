"</span>, <span class=3D"hljs-string">"gmv"</span>, <span class=3D"hljs-str=
ing">"price"</span>])
        index =3D pivot[<span class=3D"hljs-string">"price"</span>].reset_i=
ndex()[rows]

        <span class=3D"hljs-comment"># learn mask (1 price left for each SK=
U)</span>
        self.target_margin_ =3D target
        mask =3D pd.Series(self.trained_mask(pivot), name=3D<span class=3D"=
hljs-string">"price_rank"</span>)

        <span class=3D"hljs-comment"># convert from masked pivot to "True-F=
alse mask"</span>
        index =3D pd.concat([index, mask], axis=3D<span class=3D"hljs-numbe=
r">1</span>)
        index =3D index.set_index(rows + cols).index
        final_mask =3D df.set_index(rows + cols).index.isin(index).tolist()

        <span class=3D"hljs-keyword">return</span> final_mask

    <span class=3D"hljs-keyword">def</span> <span class=3D"hljs-title funct=
ion_">score</span>(<span class=3D"hljs-params">
        self, mask: torch.Tensor, gmv: torch.Tensor, margin: torch.Tensor
    </span>) -&gt; torch.Tensor:
        <span class=3D"hljs-string">"""Scoring for 2D mask, gmv and margin"=
""</span>
        <span class=3D"hljs-comment"># selected (GMV, margin) from grid</sp=
an>
        margin_1d =3D (margin * mask).<span class=3D"hljs-built_in">sum</sp=
an>(axis=3D<span class=3D"hljs-number">1</span>)
        gmv_1d =3D (gmv * mask).<span class=3D"hljs-built_in">sum</span>(ax=
is=3D<span class=3D"hljs-number">1</span>)

        <span class=3D"hljs-comment"># penetration &amp; weighted margin</s=
pan>
        gmv_total =3D gmv_1d.<span class=3D"hljs-built_in">sum</span>()
        penetration =3D gmv_1d / gmv_total
        weighted_margin =3D (margin_1d * penetration).<span class=3D"hljs-b=
uilt_in">sum</span>()

        <span class=3D"hljs-comment"># loss</span>
        diff =3D self.target_margin_ - weighted_margin
        loss =3D self.penalty * torch.relu(diff)
        score =3D gmv_total * (<span class=3D"hljs-number">1</span> - loss)

        <span class=3D"hljs-keyword">return</span> score

    <span class=3D"hljs-keyword">def</span> <span class=3D"hljs-title funct=
ion_">trained_mask</span>(<span class=3D"hljs-params">self, pivot: pd.DataF=
rame</span>) -&gt; np.ndarray:
        <span class=3D"hljs-string">"""Mask for optimal (SKU x Price)-grid"=
""</span>
        torch.manual_seed(self.random_state)

        <span class=3D"hljs-comment"># select 2D margin &amp; GMV from pivo=
t DataFrame</span>
        margin_2d =3D torch.Tensor(pivot[<span class=3D"hljs-string">"margi=
n"</span>].values)
        gmv_2d =3D torch.Tensor(pivot[<span class=3D"hljs-string">"gmv"</sp=
an>].values)
        n_skus, n_prices =3D pivot[<span class=3D"hljs-string">"price"</spa=
n>].shape

        <span class=3D"hljs-comment"># init best_score</span>
        best_mask =3D self.learnable_mask(n_skus, n_prices)
        best_score =3D <span class=3D"hljs-built_in">float</span>(<span cla=
ss=3D"hljs-string">"-inf"</span>)

        <span class=3D"hljs-comment"># train-loop</span>
        <span class=3D"hljs-keyword">for</span> _ <span class=3D"hljs-keywo=
rd">in</span> <span class=3D"hljs-built_in">range</span>(self.n_trials):
            mask =3D self.learnable_mask(n_skus, n_prices)
            optimizer =3D torch.optim.Adam(
                mask.parameters(), lr=3Dself.learning_rate
            )

            <span class=3D"hljs-comment"># float mask on train</span>
            <span class=3D"hljs-keyword">for</span> _ <span class=3D"hljs-k=
eyword">in</span> <span class=3D"hljs-built_in">range</span>(self.n_iters):
                loss =3D -self.score(mask(), gmv_2d, margin_2d)
                loss.backward()
                optimizer.step()
                optimizer.zero_grad()

            <span class=3D"hljs-comment"># OHE-mask on inference</span>
            score =3D self.score(mask.ohe(), gmv_2d, margin_2d)
            <span class=3D"hljs-keyword">if</span> score &gt; best_score:
                best_score =3D score
                best_mask =3D mask

        <span class=3D"hljs-keyword">return</span> best_mask.mask().cpu().d=
etach().numpy()

<span class=3D"hljs-meta">    @staticmethod</span>
    <span class=3D"hljs-keyword">def</span> <span class=3D"hljs-title funct=
ion_">learnable_mask</span>(<span class=3D"hljs-params">n_skus: <span class=
=3D"hljs-built_in">int</span>, n_prices: <span class=3D"hljs-built_in">int<=
/span></span>) -&gt; torch.nn.Module:
        <span class=3D"hljs-string">"""Returns initialized Learnable Mask o=
f defined shape"""</span>

        <span class=3D"hljs-keyword">class</span> <span class=3D"hljs-title=
 class_">PriceMask</span>(torch.nn.Module):
            <span class=3D"hljs-string">"""Learnable OHE-mask for (SKU, pri=
ce)-matrices"""</span>

            <span class=3D"hljs-keyword">def</span> <span class=3D"hljs-tit=
le function_">__init__</span>(<span class=3D"hljs-params">self, n_skus: <sp=
an class=3D"hljs-built_in">int</span>, n_prices: <span class=3D"hljs-built_=
in">int</span></span>):
                <span class=3D"hljs-built_in">super</span>().__init__()
                mask_raw_init =3D torch.rand((n_skus, n_prices))
                self.mask_raw =3D torch.nn.Parameter(mask_raw_init)
                self.n_skus =3D n_skus
                self.n_prices =3D n_prices

            <span class=3D"hljs-keyword">def</span> <span class=3D"hljs-tit=
le function_">forward</span>(<span class=3D"hljs-params">self</span>) -&gt;=
 torch.Tensor:
                <span class=3D"hljs-string">"""SoftMax form of mask (fuzzy =
OHE variant)"""</span>
                <span class=3D"hljs-keyword">return</span> torch.softmax(<s=
pan class=3D"hljs-number">100.0</span> * self.mask_raw, <span class=3D"hljs=
-number">1</span>)

            <span class=3D"hljs-keyword">def</span> <span class=3D"hljs-tit=
le function_">ohe</span>(<span class=3D"hljs-params">self</span>) -&gt; tor=
ch.Tensor:
                <span class=3D"hljs-string">"""ArgMax form of mask (OHE var=
iant)"""</span>
                <span class=3D"hljs-keyword">return</span> torch.eye(self.n=
_prices)[self.mask()]

            <span class=3D"hljs-keyword">def</span> <span class=3D"hljs-tit=
le function_">mask</span>(<span class=3D"hljs-params">self</span>) -&gt; to=
rch.Tensor:
                <span class=3D"hljs-string">"""ArgMax form of mask (indices=
 variant)"""</span>
                <span class=3D"hljs-keyword">return</span> torch.argmax(sel=
f.mask_raw, axis=3D<span class=3D"hljs-number">1</span>)

        <span class=3D"hljs-keyword">return</span> PriceMask(n_skus, n_pric=
es)
