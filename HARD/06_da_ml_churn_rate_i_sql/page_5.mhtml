</span> * solved_total - <span class=3D"hljs-number">0.526</span> * subm_p_=
task_14d - <span class=3D"hljs-number">0.249</span> * solved_task_rate_14d =
- <span class=3D"hljs-number">0.055</span> * avg_score_14d -<span class=3D"=
hljs-number">0.046</span> * score_diff - <span class=3D"hljs-number">0.234<=
/span> * avg_level_14d - <span class=3D"hljs-number">0.277</span> * avg_slv=
d_level_14d
    ) <span class=3D"hljs-keyword">as</span> predict_14d
