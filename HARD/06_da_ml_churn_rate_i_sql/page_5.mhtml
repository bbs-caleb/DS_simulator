13</span> PRECEDING AND CURRENT ROW
                )
        )
    GROUP BY day,
        user_id,
        subm_p_task_14d,
        solved_task_rate_14d,
        avg_score_14d,
        score_diff,
        avg_level_14d,
        avg_slvd_level_14d
    ORDER BY day,
        user_id
),
feat_total AS (
    SELECT *
    FROM feat1
        JOIN feat2 USING(day, user_id)
    WHERE day =3D <span class=3D"hljs-string">'2022-11-19'</span>
)
SELECT day,
    user_id,
    (
        <span class=3D"hljs-number">0.009</span> * is_weekend + <span class=
=3D"hljs-number">0.001</span> * days_offline - <span class=3D"hljs-number">=
0.019</span> * max_days_off - <span class=3D"hljs-number">0.637</span> * da=
ys_online - <span class=3D"hljs-number">1.048</span> * max_days_on - <span =
class=3D"hljs-number">0.189</span> * avg_submits_14d - <span class=3D"hljs-=
